# FindYourPeace — Environment Configuration Template
# Copy this file to .env.local and fill in your values.

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/StayNest

# Secret key for signing HS256 HttpOnly session JWTs (minimum 32 random characters)
JWT_SECRET=replace_with_a_strong_random_32_character_secret_key

